# Optional. Without it the marketing site and case pages work, but /login,
# /register and /profile stay disabled. Apply lib/db/schema.sql to your database.
# DATABASE_URL=postgresql://user:password@localhost:5432/luno

# Required in production. Signs session cookies and OAuth state. Generate one with:
#   openssl rand -base64 48
AUTH_SECRET=

# Canonical site origin. Used for cookie scope, OAuth redirects and outbound links.
APP_URL=http://localhost:3000

# Google sign-in. Authorized redirect URI must match the callback route:
#   ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outbound email (OTP codes, password reset). Use an app password, not an account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
